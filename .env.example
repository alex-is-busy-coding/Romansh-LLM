# cp .env.example .env  
# then set your Hugging Face token (for gated models, e.g. Llama).
# .env is gitignored; never commit real tokens.

# Either HF_TOKEN or HUGGING_FACE_HUB_TOKEN is accepted.
# HF_TOKEN=your_token_here

# Optional: logging level (DEBUG, INFO, WARNING, ERROR). Default: INFO.
# LOG_LEVEL=DEBUG
